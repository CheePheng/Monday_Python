{
  // CRM sync Worker — SEPARATE deployment from the live `hubspot-monday-sync`.
  // This worktree inherited production config verbatim; renaming it is what stops an accidental
  // `wrangler deploy` here from overwriting the live Work Management Worker.
  "name": "hubspot-monday-crm-sync",
  // COMPANY Cloudflare account — pinned deliberately as a second guard. Wrangler auth is
  // machine-global, so switching accounts for an unrelated project silently retargets this one
  // (that is exactly what happened on 2026-09-07). With the account pinned, a mismatched profile
  // ERRORS instead of quietly deploying to a personal account.
  // Verified from wrangler logs: every hubspot-monday-sync deploy used this account.
  "account_id": "5f4d31a75fd669df8527210deb973591",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",

  // NO CRONS in Phase 1. The production config carries */10 (incremental) and 0 3 (full sweep);
  // inheriting those would start unattended sweeps on day one — see handoff §5, §19.
  // Re-enable the 10-minute incremental only after webhook behaviour is proven, and only with the
  // CRM ownership scope enforced. The 03:00 full sweep stays off permanently for CRM.

  // DRY_RUN starts TRUE: Phase A writes nothing at all. Phase B flips this to "false" while the
  // code path keeps writeHubspot=false, giving real HubSpot -> monday CRM writes with every
  // HubSpot mutation still blocked (handoff §10).
  // ENABLE_CRM IS LOAD-BEARING AND WAS MISSING. specsFor() is EXCLUSIVE: without this var the
  // deployed CRM Worker resolves the WORK MANAGEMENT specs and becomes a second processor for the
  // live WM boards — writing them twice, with a token that can also write HubSpot. Exactly the
  // failure the exclusive gate exists to prevent. Only the literal string "true" enables CRM mode.
  "vars": { "DRY_RUN": "true", "WRITE_HUBSPOT": "false", "MAX_WRITES": "25", "ENABLE_CRM": "true" },

  "observability": { "enabled": true },

  // A new Worker script gets its OWN Durable Object namespace, so CRM idempotency state can never
  // collide with production's. The v1 migration is required to create the class on a fresh script.
  "durable_objects": {
    "bindings": [
      { "name": "CREATE_IDEMPOTENCY", "class_name": "CreateIdempotency" },
      // Durable activity retry. One instance per stuck activity + one dead-letter index; the alarm
      // is the retry clock. Deliberately NOT Cloudflare Queues — see activity-retry.ts.
      { "name": "ACTIVITY_RETRY", "class_name": "ActivityRetry" }
    ]
  },
  // v2 is ADDITIVE: it creates a new class and leaves CreateIdempotency's stored state untouched.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["CreateIdempotency"] },
    { "tag": "v2", "new_sqlite_classes": ["ActivityRetry"] }
  ]
}
